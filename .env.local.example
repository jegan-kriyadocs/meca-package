# ==============================================================================
# LOCAL DEVELOPMENT CONFIGURATION (.env.local.example)
# ==============================================================================
# Copy this file to .env in the repository root for local development:
#   cp .env.local.example .env
#
# QUICK START:
# - LIGHTWEIGHT FILE-BASED MODE (No Database required):
#   Leave DATABASE_URL commented out below. All batch data stores locally in files!
#
# - WITH LOCAL POSTGRESQL:
#   Uncomment DATABASE_URL below and start PostgreSQL (or docker-compose).
#   Tables are auto-created on first server startup!
#
# NOTE ON INPUT / OUTPUT (Local vs S3 / SFTP):
# Toggle between Local and S3/SFTP directly from the Dashboard UI (Configuration tab).
# You do NOT need to set INPUT_PROVIDER or OUTPUT_PROVIDER environment variables.
# ==============================================================================

# --- Web Dashboard & Node.js Server ---
PORT=4000
NODE_ENV=development

# --- MECA Engine Runtime & Logging ---
MECA_ENGINE_ENVIRONMENT=dev
MECA_ENGINE_CONFIG_DIR=./config
MECA_ENGINE_DEBUG_LOGGING=false

# --- Python Interpreter Auto-Detection ---
# The backend automatically detects meca-engine/.venv/bin/python3 on local machines,
# and falls back to system 'python3' in Docker containers.
# Uncomment only if you need a custom python interpreter:
# DASHBOARD_PYTHON_BIN=/path/to/custom/python3
# DASHBOARD_PYTHONPATH_EXTRA=/path/to/custom/src

# --- Database (PostgreSQL) ---
# Uncomment to use local PostgreSQL; leave commented out to run in standalone file-based mode.
DATABASE_URL=postgresql://meca_user:meca_password@localhost:5432/meca_db?schema=public

# --- Optional: AWS S3 Configuration (for testing S3 input locally) ---
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your_s3_bucket
# S3_INPUT_PREFIX=meca-ppl/

# --- Optional: SFTP Configuration (for testing SFTP output locally) ---
# SFTP_HOST=your-sftp-host.com
# SFTP_PORT=22
# SFTP_USER=your_username
# SFTP_PASSWORD=your_password
# SFTP_REMOTE_DIR=.
