# ==============================================================================
# PRODUCTION CLOUD CONFIGURATION (.env.production)
# ==============================================================================
# Use these environment variables when deploying to AWS ECS / Fargate, Kubernetes,
# or your production container environment.
#
# INJECTION BEST PRACTICE:
# In AWS ECS / Fargate, inject secrets (DATABASE_URL, SFTP_PASSWORD) via
# AWS Secrets Manager or AWS Systems Manager Parameter Store.
# ==============================================================================

# --- Server & Runtime Environment ---
PORT=4000
NODE_ENV=production
MECA_ENGINE_ENVIRONMENT=production

# --- Production Database (AWS RDS PostgreSQL) ---
# Required for persisting batch history, review statuses, and metrics.
# Format: postgresql://<USERNAME>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DATABASE_NAME>?sslmode=require
DATABASE_URL=postgresql://meca_admin:<PASSWORD>@your-rds-cluster.rds.amazonaws.com:5432/meca_db?sslmode=require

# --- AWS S3 Configuration (Input Source) ---
# NOTE: AWS credentials (Access Key / Secret Key) are NOT required here when running
# on AWS ECS/EC2 with an IAM Task Role attached. The AWS SDK reads credentials automatically.
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-meca-input-bucket
S3_INPUT_PREFIX=submissions/

# --- SFTP Configuration (Output Destination) ---
# NOTE: The engine connects via SFTP (SSH File Transfer Protocol on Port 22), NOT plain FTP (Port 21).
# You only need HOST, USER, and PASSWORD:
SFTP_HOST=your-sftp-server.example.com
SFTP_USER=your_sftp_username
SFTP_PASSWORD=your_sftp_password

# Optional SFTP variables (leave commented to use standard port 22 and default home folder):
# SFTP_PORT=22
# SFTP_REMOTE_DIR=.

# Optional SFTP tuning:
# SFTP_KEY_PATH=/path/to/private_key.pem # Optional: use SSH private key instead of password
# SFTP_DELETE_LOCAL_AFTER_UPLOAD=false   # Set to true to delete staged zip after successful upload
